    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.4",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-location": "~57.0.4",
    "expo-router": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "@babel/highlight": "7.25.9",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-community/netinfo": "~12.0.1",
    "expo": "~57.0.6",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "^57.0.5",
    "expo-audio": "~57.0.2",
    "expo-auth-session": "~57.0.3",
