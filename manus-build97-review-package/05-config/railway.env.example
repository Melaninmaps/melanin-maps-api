# Railway Production Environment Variables
# Mapping With Melanin™ — Build 97 Review Package
# Template only — no values included.
# These must be set in the Railway project dashboard under the API service.

# All variables from api.env.example are also required on Railway.
# This file documents Railway-specific variables and deployment configuration.

# ─── Railway Auto-Injected ───────────────────────────────────────────────────
PORT=                             # Auto-set by Railway. API server reads this. Do not override.
RAILWAY_ENVIRONMENT=              # "production" when on Railway.
RAILWAY_STATIC_URL=               # Railway static URL (if configured).

# ─── Railway PostgreSQL ──────────────────────────────────────────────────────
DATABASE_URL=                     # Railway Postgres internal URL.
                                  # Format: postgresql://user:pass@host.internal/db
                                  # Contains ".internal" — no SSL applied (per pool config logic)
                                  # Alternative: Public proxy URL (needs ssl:{rejectUnauthorized:false})

# ─── Deployment Configuration ────────────────────────────────────────────────
NODE_ENV=production               # Required. Enables production optimizations.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60  # Set to 60 for graceful shutdown window.
                                        # Ensures in-flight requests finish before SIGKILL.

# ─── Health Check ────────────────────────────────────────────────────────────
# Railway health check configured in artifact.toml:
# path = "/api/readyz"
# initialDelaySeconds = 10
# timeoutSeconds = 10
# periodSeconds = 10
# failureThreshold = 30

# ─── Required for Full Functionality ─────────────────────────────────────────
# All of the following must also be set on Railway:
DATABASE_URL=
SESSION_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
ADMIN_EMAILS=
CRON_SECRET=
WMATA_API_KEY=
COMPANY_MAILING_ADDRESS=
DOCUSIGN_USER_ID=
DOCUSIGN_RSA_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
