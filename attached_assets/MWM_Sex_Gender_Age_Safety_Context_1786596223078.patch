## 4. Private API and update behavior

**New router:** `artifacts/api-server/src/routes/identity-context.ts`

```ts
const IdentityPatch = z.object({
  sexAssignedAtBirth: z.enum(['female', 'male', 'intersex', 'prefer_not_to_say']).nullable().optional(),
  genderIdentity: z.enum(['woman', 'man', 'nonbinary', 'another_identity', 'prefer_not_to_say']).nullable().optional(),
  pronounSet: z.enum(['she_her', 'he_him', 'they_them', 'use_my_name', 'custom', 'prefer_not_to_say']).nullable().optional(),
  customPronouns: z.string().trim().min(1).max(80).nullable().optional(),
  allowMedicallyRelevantContext: z.boolean().optional(),
  allowPronounAwareLanguage: z.boolean().optional(),
  expectedVersion: z.number().int().positive(),
}).superRefine((value, ctx) => {
  if (value.pronounSet === 'custom' && !value.customPronouns) {
    ctx.addIssue({ code: 'custom', path: ['customPronouns'], message: 'Custom pronouns are required when custom is selected.' });
  }
  if (value.pronounSet !== 'custom' && value.customPronouns) {
    ctx.addIssue({ code: 'custom', path: ['customPronouns'], message: 'Custom pronouns may be stored only with custom selection.' });
  }
});

router.get('/me/identity-context', requireAuth, async (req, res) => {
  const context = await loadIdentityContext(req.user.id);
  // Decrypt custom pronouns only for the same authenticated member.
  return res.json(toPrivateMemberIdentityDto(context));
});

router.put('/me/identity-context', requireAuth, async (req, res) => {
  const patch = IdentityPatch.parse(req.body);
  await db.transaction(async (tx) => {
    const current = await loadIdentityContextForUpdate(tx, req.user.id);
    if (current && current.version !== patch.expectedVersion) {
      throw new HttpError(409, 'IDENTITY_CONTEXT_CONFLICT');
    }
    const next = normalizeIdentityPatch(patch, current);
    await upsertIdentityContext(tx, req.user.id, next); // increments version
    await tx.insert(userIdentityContextAudit).values({
      id: crypto.randomUUID(),
      userId: req.user.id,
      actorUserId: req.user.id,
      changedFields: changedFieldNames(current, next),
      reason: 'member_update',
    });
  });
  return res.json({ ok: true });
});
```

Members can change their selections at any time. The server must invalidate any in-memory Kinfolk profile context for that member immediately. Audit records show only field names, never values. A privacy support change must require a restricted role and include a reason.

