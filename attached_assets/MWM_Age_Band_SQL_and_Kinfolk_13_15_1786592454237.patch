## Patch 2 — Add the Drizzle tables

**New file:** `lib/db/src/schema/age-assurance.ts`

```ts
import { sql } from 'drizzle-orm';
import { boolean, index, pgTable, text, timestamp, uniqueIndex, uuid, varchar } from 'drizzle-orm/pg-core';
import { usersTable } from './auth';

export const ageBandValues = ['unknown', 'under_13', '13_15', '16_17', '18_plus'] as const;
export type AgeBand = (typeof ageBandValues)[number];

export const userAgeAssuranceTable = pgTable('user_age_assurance', {
  userId: varchar('user_id', { length: 255 }).primaryKey()
    .references(() => usersTable.id, { onDelete: 'cascade' }),
  ageBand: varchar('age_band', { length: 16, enum: ageBandValues })
    .notNull().default('unknown'),
  assuranceMethod: varchar('assurance_method', {
    length: 32,
    enum: ['unconfirmed', 'self_attested_band', 'self_attested_dob', 'parental_consent', 'verified_provider'],
  }).notNull().default('unconfirmed'),
  policyVersion: varchar('policy_version', { length: 64 }).notNull().default('age-assurance-v1'),
  assuredAt: timestamp('assured_at', { withTimezone: true }),
  nextRecheckAt: timestamp('next_recheck_at', { withTimezone: true }),
  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow().$onUpdate(() => new Date()),
}, (t) => [index('idx_user_age_assurance_band').on(t.ageBand)]);

export const contentAudiencePolicyTable = pgTable('content_audience_policy', {
  id: uuid('id').primaryKey().default(sql`gen_random_uuid()`),
  resourceType: varchar('resource_type', { length: 64 }).notNull(),
  resourceId: varchar('resource_id', { length: 255 }).notNull(),
  minimumAgeBand: varchar('minimum_age_band', { length: 16, enum: ['13_15', '16_17', '18_plus'] as const })
    .notNull().default('13_15'),
  sensitivityTags: text('sensitivity_tags').array().notNull().default(sql`'{}'::text[]`),
  graphicLevel: varchar('graphic_level', { length: 16, enum: ['none', 'limited', 'graphic'] as const })
    .notNull().default('none'),
  requiresContextScreen: boolean('requires_context_screen').notNull().default(false),
  policyReason: text('policy_reason'),
  assignedByUserId: varchar('assigned_by_user_id', { length: 255 })
    .references(() => usersTable.id, { onDelete: 'set null' }),
  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
  updatedAt: timestamp('updated_at', { withTimezone: true }).notNull().defaultNow().$onUpdate(() => new Date()),
}, (t) => [uniqueIndex('content_audience_policy_resource_uq').on(t.resourceType, t.resourceId)]);

export const ageDeliveryAuditEventsTable = pgTable('age_delivery_audit_events', {
  id: uuid('id').primaryKey().default(sql`gen_random_uuid()`),
  userId: varchar('user_id', { length: 255 }).notNull()
    .references(() => usersTable.id, { onDelete: 'cascade' }),
  resourceType: varchar('resource_type', { length: 64 }).notNull(),
  resourceId: varchar('resource_id', { length: 255 }),
  decision: varchar('decision', { length: 24, enum: ['allowed', 'adapted', 'context_screen', 'blocked'] as const }).notNull(),
  audienceBandAtDecision: varchar('audience_band_at_decision', { length: 16, enum: ageBandValues }).notNull(),
  policyVersion: varchar('policy_version', { length: 64 }).notNull(),
  createdAt: timestamp('created_at', { withTimezone: true }).notNull().defaultNow(),
}, (t) => [index('idx_age_delivery_events_user_created').on(t.userId, t.createdAt)]);
```

Export these tables from the schema barrel. Do **not** add `ageBand` to public user/profile DTOs or session serialization.

