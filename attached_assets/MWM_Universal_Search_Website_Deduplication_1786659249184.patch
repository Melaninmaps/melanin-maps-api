+const NON_OFFICIAL_DOMAIN_HOSTS = new Set([
+  "facebook.com", "instagram.com", "tiktok.com", "yelp.com", "google.com",
+  "maps.google.com", "tripadvisor.com", "doordash.com", "ubereats.com",
