# New file: scripts/verify-release-artifacts.mjs
# Run this after the production build and before git commit/deploy.
import fs from "node:fs";
import path from "node:path";
import { createHash } from "node:crypto";

const root = process.cwd();
const apiRoot = path.join(root, "artifacts", "api-server");
const entry = path.join(apiRoot, "dist", "index.mjs");
const identityPath = path.join(apiRoot, "dist", "BUILD_IDENTITY");
const servedStatic = path.join(root, "web-static", "index.html");
const builtStatic = path.join(apiRoot, "web-static", "index.html");

function die(message) { console.error(`RELEASE_VERIFY_FAIL: ${message}`); process.exit(1); }
function hash(file) { return createHash("sha256").update(fs.readFileSync(file)).digest("hex"); }
for (const file of [entry, identityPath, servedStatic, builtStatic]) {
  if (!fs.existsSync(file)) die(`missing ${path.relative(root, file)}`);
}
const identity = JSON.parse(fs.readFileSync(identityPath, "utf8"));
if (identity.bundle_sha256 !== hash(entry)) die("dist/index.mjs does not match dist/BUILD_IDENTITY");
if (fs.readFileSync(servedStatic, "utf8") !== fs.readFileSync(builtStatic, "utf8")) {
  die("root web-static/index.html differs from artifacts/api-server/web-static/index.html");
}
console.log(JSON.stringify({ ok: true, built_from_sha: identity.built_from_sha, bundle_sha256: identity.bundle_sha256 }, null, 2));

