+/**
+ * Evidence-led consensus resolver.  It must be invoked before the LLM writes
+ * a conclusion.  It never uses a member's inferred race, ethnicity, age,
+ * religion, political view, or neighborhood to decide what the answer is.
+ */
+export type ConsensusState =
+  | "broad_consensus"
+  | "segmented_consensus"
+  | "contested"
+  | "insufficient_evidence";
+
+export type PerspectiveEvidence = {
+  id: string;
+  canonicalEntityId: string;
+  publisher: string;
+  url: string;
+  publishedAt: string;
+  /** Only categories described by the source itself; never an inferred audience. */
+  audienceScope: "general_public" | "professional_critics" | "fan_community" | "scholarly" | "award_body" | "industry";
+  viewpoint: "supports" | "opposes" | "mixed";
+  factualClaims: string[];
+  sourceTier: "official" | "reputable" | "institutional" | "peer_reviewed";
+  independentPublisherKey: string;
+};
+
+export type ConsensusResolution = {
+  state: ConsensusState;
+  conclusion: string | null;
+  rationale: string[];
+  perspectiveSummary: Array<{
+    audienceScope: PerspectiveEvidence["audienceScope"];
+    conclusion: "supports" | "opposes" | "mixed";
+    sourceIds: string[];
+  }>;
+  sources: PerspectiveEvidence[];
+  needsClarification: boolean;
+};
+
+function independentCount(rows: PerspectiveEvidence[]) {
+  return new Set(rows.map((row) => row.independentPublisherKey)).size;
+}
+
+export function resolveConsensus(
+  entityId: string,
+  evidence: PerspectiveEvidence[],
+): ConsensusResolution {
+  const usable = evidence.filter((e) =>
+    e.canonicalEntityId === entityId &&
+    ["official", "reputable", "institutional", "peer_reviewed"].includes(e.sourceTier),
+  );
+  const supports = usable.filter((e) => e.viewpoint === "supports");
+  const opposes = usable.filter((e) => e.viewpoint === "opposes");
+  const mixed = usable.filter((e) => e.viewpoint === "mixed");
+  const perspectiveSummary = (["general_public", "professional_critics", "fan_community", "scholarly", "award_body", "industry"] as const)
+    .map((audienceScope) => {
+      const rows = usable.filter((e) => e.audienceScope === audienceScope);
+      if (!rows.length) return null;
+      const support = rows.filter((e) => e.viewpoint === "supports").length;
+      const oppose = rows.filter((e) => e.viewpoint === "opposes").length;
+      return {
+        audienceScope,
+        conclusion: support === oppose ? "mixed" : support > oppose ? "supports" : "opposes",
+        sourceIds: rows.map((e) => e.id),
+      } as const;
+    })
+    .filter(Boolean) as ConsensusResolution["perspectiveSummary"];
+
+  if (usable.length < 2 || independentCount(usable) < 2) {
+    return { state: "insufficient_evidence", conclusion: null, rationale: [], perspectiveSummary, sources: usable, needsClarification: false };
+  }
+
+  // If attributable source groups materially differ, surface that divergence;
+  // do not average it into a fictional majority.
+  const scopedConclusions = new Set(perspectiveSummary.map((x) => x.conclusion));
+  if (scopedConclusions.size > 1 || (supports.length > 0 && opposes.length > 0 && mixed.length > 0)) {
+    return {
+      state: "segmented_consensus",
+      conclusion: null,
+      rationale: ["Credible sources describe different conclusions across attributable audiences."],
+      perspectiveSummary,
+      sources: usable,
+      needsClarification: false,
+    };
+  }
+
+  if (independentCount(supports) >= 2 && opposes.length === 0) {
+    return {
+      state: "broad_consensus",
+      conclusion: "supports",
+      rationale: ["Multiple independent credible sources point to the same cultural/public assessment."],
+      perspectiveSummary,
+      sources: usable,
+      needsClarification: false,
+    };
+  }
+
+  return {
+    state: "contested",
+    conclusion: null,
+    rationale: ["Credible evidence does not support one clear public consensus."],
+    perspectiveSummary,
+    sources: usable,
+    needsClarification: false,
+  };
+}
