+import type { ConsensusResolution } from "./consensus-resolver";
+
+export type DeliveryLevel = "brief" | "standard" | "deep";
+
+export function buildConsensusInstructions(
+  resolution: ConsensusResolution,
+  delivery: DeliveryLevel,
+): string {
+  const sourceList = resolution.sources.map((s) => `[${s.id}] ${s.publisher} (${s.publishedAt})`).join("\n");
+  return [
+    "Write an answer using only the resolution and cited sources below.",
+    "Never state cultural consensus as an objective fact.",
+    "Never claim that a demographic thinks something unless that exact attributable source says so.",
+    "Never infer the member's identity or tailor the conclusion based on identity.",
+    `Consensus state: ${resolution.state}.`,
+    `Perspective summary: ${JSON.stringify(resolution.perspectiveSummary)}.`,
+    `Rationale: ${resolution.rationale.join(" ")}`,
+    `Delivery level: ${delivery}.`,
+    resolution.state === "broad_consensus"
+      ? "Lead with a direct answer followed by ‘This reflects broad public and cultural consensus, not an objective fact.’"
+      : resolution.state === "segmented_consensus"
+        ? "Lead with ‘There is not one single consensus.’ Explain the attributable perspectives side by side without ranking one as universal."
+        : resolution.state === "contested"
+          ? "Lead with ‘There is no clear public consensus.’ Summarize the strongest positions fairly."
+          : "Say that available credible sources do not establish a reliable consensus; offer a narrower follow-up question if useful.",
+    `Sources:\n${sourceList}`,
+  ].join("\n");
+}
+
+export function preserveHighConsequenceSafety(base: string, safetyNotice?: string): string {
+  return safetyNotice ? `${base}\n\n${safetyNotice}` : base;
+}
