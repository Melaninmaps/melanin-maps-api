+/**
+ * ResponseMode controls answer composition.  It does not replace the intent
+ * or lower the evidence policy.  An opinion/consensus question remains
+ * culture_entertainment; a diabetes question remains medical_health.
+ */
+export type KinfolkResponseMode =
+  | "general_explainer"
+  | "consensus_analysis"
+  | "cultural_entity"
+  | "local_discovery"
+  | "education_discovery"
+  | "high_consequence_evidence"
+  | "current_events"
+  | "needs_clarification";
+
+const CONSENSUS_PATTERNS = [
+  /\bwho won (?:the )?(?:beef|battle|versus|vs\.?|argument)\b/i,
+  /\bwho (?:is|was) (?:better|the best|the greatest)\b/i,
+  /\bwhat(?:'s| is) the consensus\b/i,
+  /\bhow do (?:people|critics|fans|the public) (?:see|view|feel about)\b/i,
+  /\bwho came out on top\b/i,
+];
+
+const EDUCATION_PATTERNS = [
+  /\bcollege(?:s)?\b/i, /\buniversity|universities\b/i,
+  /\bhbcu(?:s)?\b/i, /\bcampus\b/i,
+];
+
+/**
+ * Must be called after entity resolution but before MWM business retrieval.
+ * Explicit query wording always outranks preference data.
+ */
+export function resolveResponseMode(args: {
+  message: string;
+  intent: KinfolkIntent;
+  hasNamedEntity: boolean;
+  hasExplicitPlace: boolean;
+}): KinfolkResponseMode {
+  const { message, intent, hasNamedEntity, hasExplicitPlace } = args;
+  if (intent === "medical_health" || intent === "legal_regulated" ||
+      intent === "financial_regulated" || intent === "safety_emergency") {
+    return "high_consequence_evidence";
+  }
+  if (intent === "current_information") return "current_events";
+  if (EDUCATION_PATTERNS.some((p) => p.test(message))) return "education_discovery";
+  if (CONSENSUS_PATTERNS.some((p) => p.test(message))) return "consensus_analysis";
+  if (hasNamedEntity && intent === "culture_entertainment") return "cultural_entity";
+  if (hasExplicitPlace && intent === "business_discovery") return "local_discovery";
+  return "general_explainer";
+}
