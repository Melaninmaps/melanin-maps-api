# New migration: additive only; do not retain raw query text.
CREATE TABLE IF NOT EXISTS kinfolk_delivery_events (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  message_id UUID NOT NULL,
  requested_level TEXT NOT NULL CHECK (requested_level IN ('brief', 'standard', 'deep')),
  domain_class TEXT NOT NULL CHECK (domain_class IN ('general', 'culture', 'local', 'education', 'high_consequence')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS kinfolk_delivery_events_user_created_idx
  ON kinfolk_delivery_events (user_id, created_at DESC);

# Never write the raw message, entity, diagnosis, medical category, legal category,
# city, content text, source text, or community identity to this event table.

# Read-only capability-audit rule for conflicting consensus:
# For each test query, audit output must include:
# - Canonical entity/event ID.
# - Every candidate source, publisher, source tier, date, and cited audience scope.
# - Whether the scope comes from the source itself or is unsupported.
# - The independent-publisher count and conclusion state.
# - A rejection list for non-independent, stale, irrelevant, or unattributed claims.
# - The raw pre-LLM consensus object and post-LLM answer.
# No audit output may say “Black people think…” / “Latinos think…” / “women think…”
# unless the cited source itself supports the exact description, method, date, and scope.

# Required conflict outcomes:
# 1. broad_consensus: direct qualified conclusion plus dissent/nuance.
# 2. segmented_consensus: no universal winner; show attributable perspectives side by side.
# 3. contested: no clear consensus; show strongest documented positions.
# 4. insufficient_evidence: do not manufacture a consensus; say what cannot be established.
