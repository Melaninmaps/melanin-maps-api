 const RESPONSE_STYLES = ['conversational', 'concise', 'detailed', 'professional'] as const;
 type ResponseStyle = (typeof RESPONSE_STYLES)[number];
+
+function responseStyleFromServer(payload: KinfolkPreferencesResponse): ResponseStyle {
+  // Prefer explicit responseStyle. Do not let legacy communicationStyle reset
+  // the modern control to conversational after a hard refresh.
+  if (payload.responseStyle && RESPONSE_STYLES.includes(payload.responseStyle)) {
+    return payload.responseStyle;
+  }
+  const profile = payload.deliveryProfile;
+  const detailLevel = profile?.detailLevel ?? profile?.detail_level;
+  const tone = profile?.tonePreference ?? profile?.tone_preference;
+  if (tone === 'professional') return 'professional';
+  if (detailLevel === 'deep') return 'detailed';
+  if (detailLevel === 'quick') return 'concise';
+  return 'conversational';
+}
