--- a/server/kinfolk/evidence-retrieval-service.ts
+++ b/server/kinfolk/evidence-retrieval-service.ts
@@
 export type EvidenceItem = {
   id: string;
   title: string;
   url: string | null;
   origin: 'LIBRARY' | 'MWM_DIRECTORY' | 'LIVE_WEB' | 'COMMUNITY';
   verifiedAt: string | null;
   permittedForResponse: boolean;
 };
+
+export type EvidenceResolution = {
+  items: EvidenceItem[];
+  degraded: boolean;
+  failureCode?: 'SOURCE_POLICY_UNAVAILABLE' | 'EVIDENCE_RETRIEVAL_FAILED';
+};
+
+/**
+ * Converts an evidence-layer availability failure into a controlled response
+ * state. It must never turn a legal/medical/travel-policy request into a 500.
+ * `degraded: true` means no source claim may be made in the assistant reply.
+ */
+export async function resolveEvidenceSafely(input: Parameters<typeof resolveEvidenceForPlan>[0]): Promise<EvidenceResolution> {
+  try {
+    const items = await resolveEvidenceForPlan(input);
+    return { items, degraded: false };
+  } catch (error) {
+    input.logger?.warn?.(
+      { err: error, intentClass: input.plan.intent, sourcePolicyId: input.plan.sourcePolicyId },
+      'kinfolk_evidence_resolution_degraded',
+    );
+    return {
+      items: [],
+      degraded: true,
+      failureCode: 'EVIDENCE_RETRIEVAL_FAILED',
+    };
+  }
+}

