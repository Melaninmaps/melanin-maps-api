## 4. Exact Show less / Show more loop

### API

**New route in `kinfolk.ts`:**

```ts
router.post('/kinfolk/answer-plans/:answerPlanId/depth', async (req, res) => {
  if (!req.user?.id) return res.status(401).json({ error: 'Authentication required' });
  const desiredDepth = req.body?.depth;
  if (!['brief', 'standard', 'deep'].includes(desiredDepth)) {
    return res.status(400).json({ error: 'INVALID_DEPTH' });
  }

  const found = await pool.query(
    `SELECT domain_class, is_sensitive, audience_band, plan_json
       FROM kinfolk_answer_plans
      WHERE id = $1 AND user_id = $2 AND expires_at > now()
      LIMIT 1`,
    [req.params.answerPlanId, req.user.id],
  );
  if (!found.rowCount) return res.status(404).json({ error: 'ANSWER_PLAN_EXPIRED' });

  const row = found.rows[0];
  const plan = row.plan_json;
  const ageBand = await getMemberAgeBand(req.user.id);
  const delivered = composeAudienceAwareAnswer({ plan, ageBand, depth: desiredDepth, isAgeAssured: ageBand !== 'unknown' });

  const action = desiredDepth === 'deep' ? 'show_more' : 'show_less';
  const eligible = eligibleForDefaultLearning(row.domain_class, ageBand);
  await pool.query(
    `INSERT INTO kinfolk_depth_feedback_events
      (user_id, domain_class, action, eligible_for_default_learning, age_band_at_action)
     VALUES ($1, $2, $3, $4, $5)`,
    [req.user.id, row.domain_class, action, eligible, ageBand],
  );

  // Do not silently rewrite a global preference from health, legal, safety,
  // relationship, religion, or unknown-age interactions.
  const suggestion = eligible ? await getDepthDefaultSuggestion(req.user.id) : null;
  res.json({ ...delivered, answerPlanId: req.params.answerPlanId, defaultSuggestion: suggestion });
});
```

### Controlled learning rule

**Never auto-switch a global default after one tap.** A Show more/less tap changes only the current answer. After **three eligible, non-sensitive actions in 30 days all in the same direction**, return a banner suggestion:

```ts
async function getDepthDefaultSuggestion(userId: string) {
  const r = await pool.query(
    `SELECT action, count(*)::int AS n
       FROM kinfolk_depth_feedback_events
      WHERE user_id = $1
        AND eligible_for_default_learning = true
        AND created_at >= now() - interval '30 days'
      GROUP BY action
      ORDER BY n DESC
      LIMIT 1`, [userId]);
  const top = r.rows[0];
  if (!top || top.n < 3) return null;
  return top.action === 'show_more'
    ? { proposedDepth: 'deep', copy: 'You often choose more detail. Make Detailed your Kinfolk default?' }
    : { proposedDepth: 'quick', copy: 'You often choose shorter answers. Make Concise your Kinfolk default?' };
}
```

Only when the member explicitly confirms the banner may the server update `kinfolk_delivery_profiles.detail_level`; set `depth_updated_from='depth_feedback'`. `Dismiss` stores `adaptive_depth_prompt_dismissed_until = now() + interval '90 days'`.

