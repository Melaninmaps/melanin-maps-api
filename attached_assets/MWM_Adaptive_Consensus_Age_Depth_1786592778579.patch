async function changeAnswerDepth(message: ChatMessage, depth: 'brief' | 'standard' | 'deep') {
  if (!message.answerPlanId) return;
  const res = await fetch(`${BASE}api/kinfolk/answer-plans/${message.answerPlanId}/depth`, {
