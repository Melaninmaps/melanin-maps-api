const ageBand = await getMemberAgeBand(req.user.id);
const requestedDepth = req.body?.requestedDepth as Depth | undefined;
const defaultDepth = normalizeDepth(deliveryProfile?.detail_level);
const depth = requestedDepth ?? defaultDepth;

// `answerPlan` must be constructed from validated sources/consensus, not from
// raw LLM text. Existing general chat may use consensusState='not_applicable'.
const answerPlan = await buildKinfolkAnswerPlan({
  message,
  intentClass,
  domainClass: domainClass as DomainClass,
  libraryContext,
  verifiedEvidence,
  llmDraft,
});

