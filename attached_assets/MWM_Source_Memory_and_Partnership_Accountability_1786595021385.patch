**New migration:** `artifacts/api-server/src/lib/migrations/20260813_business_impact_accountability_v1.sql`

```sql
-- A rotating one-way fingerprint is for daily/weekly distinct-count aggregation.
-- It is never returned to a business and is never used for behavioral profiling.
CREATE TABLE IF NOT EXISTS business_impact_events (
  id VARCHAR(100) PRIMARY KEY DEFAULT gen_random_uuid()::text,
  business_id VARCHAR(100) NOT NULL REFERENCES businesses(id) ON DELETE CASCADE,
  event_type VARCHAR(32) NOT NULL CHECK (event_type IN (
    'saved', 'official_website_opened', 'public_profile_viewed',
    'voluntary_visit_marked', 'demand_signal'
  )),
  occurred_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  member_window_fingerprint VARCHAR(128) NOT NULL,
  -- For demand only: use a taxonomy term or safe normalized intent key, never
  -- raw private language. NULL for all other events.
  safe_demand_key VARCHAR(120),
  source_surface VARCHAR(32) NOT NULL CHECK (source_surface IN (
    'directory', 'map', 'kinfolk', 'library', 'community', 'business_page', 'saved_list'
  )),
  is_load_test BOOLEAN NOT NULL DEFAULT FALSE,
  CONSTRAINT impact_event_demand_rule CHECK (
    (event_type = 'demand_signal' AND safe_demand_key IS NOT NULL) OR
    (event_type <> 'demand_signal' AND safe_demand_key IS NULL)
  )
);
CREATE INDEX IF NOT EXISTS business_impact_events_rollup_idx
  ON business_impact_events(business_id, event_type, occurred_at DESC);
CREATE UNIQUE INDEX IF NOT EXISTS business_impact_events_daily_dedup
  ON business_impact_events(business_id, event_type, member_window_fingerprint, date_trunc('day', occurred_at), COALESCE(safe_demand_key, ''));

CREATE TABLE IF NOT EXISTS business_impact_rollups (
  id VARCHAR(100) PRIMARY KEY DEFAULT gen_random_uuid()::text,
  business_id VARCHAR(100) NOT NULL REFERENCES businesses(id) ON DELETE CASCADE,
  metric_type VARCHAR(32) NOT NULL CHECK (metric_type IN (
    'distinct_saves', 'official_website_opens', 'public_profile_views',
    'voluntary_visits', 'safe_demand'
  )),
  safe_demand_key VARCHAR(120),
  window_start TIMESTAMPTZ NOT NULL,
  window_end TIMESTAMPTZ NOT NULL,
  true_distinct_count INTEGER NOT NULL,
  displayed_count INTEGER,
  privacy_threshold_met BOOLEAN NOT NULL DEFAULT FALSE,
  delayed_until TIMESTAMPTZ NOT NULL,
  generated_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE(business_id, metric_type, COALESCE(safe_demand_key, ''), window_start, window_end)
);
CREATE INDEX IF NOT EXISTS business_impact_rollups_visible_idx
  ON business_impact_rollups(business_id, privacy_threshold_met, delayed_until DESC);

CREATE TABLE IF NOT EXISTS business_partnership_candidates (
  id VARCHAR(100) PRIMARY KEY DEFAULT gen_random_uuid()::text,
  business_id VARCHAR(100) NOT NULL REFERENCES businesses(id) ON DELETE CASCADE,
  program_type VARCHAR(32) NOT NULL CHECK (program_type IN (
    'minority_owned_claim_preview', 'minority_owned_partnership_preview',
    'safe_space_accountability_brief'
  )),
  ownership_basis VARCHAR(32) NOT NULL CHECK (ownership_basis IN (
    'verified_self_designation', 'owner_self_designation', 'unknown'
  )),
  snapshot JSONB NOT NULL,
  status VARCHAR(24) NOT NULL DEFAULT 'draft' CHECK (status IN (
    'draft', 'admin_review', 'approved_no_send', 'sent', 'responded', 'opted_out', 'expired', 'rejected'
  )),
  created_by VARCHAR(32) NOT NULL DEFAULT 'impact_worker',
  approved_by_user_id VARCHAR(255) REFERENCES users(id) ON DELETE SET NULL,
  approved_at TIMESTAMPTZ,
  contact_basis VARCHAR(32) CHECK (contact_basis IN ('owner_opt_in', 'public_business_contact', 'none')),
  contact_channel VARCHAR(32) CHECK (contact_channel IN ('email', 'website_form', 'instagram', 'other', 'none')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX IF NOT EXISTS business_partnership_candidates_status_idx
  ON business_partnership_candidates(status, created_at DESC);
```

**Privacy threshold:** A rollup is visible only after **10 distinct privacy-protected members**, a **24-hour reporting delay**, and rounding to the nearest five. A business never receives an exact count below threshold.

```ts
export function safeDisplayCount(trueDistinctCount: number): number | null {
  if (trueDistinctCount < 10) return null;
  return Math.round(trueDistinctCount / 5) * 5;
}
```

Thus the dashboard copy is **“About 35 members saved your business”**, not `34 named people saved you`. The system may say **“About 55 opened your official website this week”**, but it must not say **“55 booked”** based on an outbound click. `voluntary_visit_marked` is only permitted when a member explicitly marks a visit; `booking` may be reported only under a later formal partner conversion integration with separate consent and data terms.

