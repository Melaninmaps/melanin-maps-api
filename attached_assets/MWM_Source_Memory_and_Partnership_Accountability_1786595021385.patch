## Part D — Event capture and aggregate worker

**New file:** `artifacts/api-server/src/analytics/business-impact.ts`

```ts
import crypto from 'node:crypto';

const IMPACT_SECRET = process.env.BUSINESS_IMPACT_HMAC_SECRET!;

function rotatingFingerprint(userId: string, date = new Date()): string {
  const period = date.toISOString().slice(0, 10); // daily rotation
  return crypto.createHmac('sha256', IMPACT_SECRET).update(`${period}:${userId}`).digest('hex');
}

const SAFE_DEMAND_KEYS = new Set([
  'fruit_pebble_waffles', 'red_braids', 'natural_hair_care', 'brunch', 'family_activity'
]);

export async function recordImpact(input: {
  businessId: string;
  userId: string;
  eventType: 'saved' | 'official_website_opened' | 'public_profile_viewed' | 'voluntary_visit_marked' | 'demand_signal';
  safeDemandKey?: string;
  surface: 'directory' | 'map' | 'kinfolk' | 'library' | 'community' | 'business_page' | 'saved_list';
  isLoadTest: boolean;
}) {
  if (input.isLoadTest) return; // audits must not influence partnerships
  if (input.eventType === 'demand_signal' && !SAFE_DEMAND_KEYS.has(input.safeDemandKey ?? '')) return;
  await pool.query(
    `INSERT INTO business_impact_events
       (business_id, event_type, member_window_fingerprint, safe_demand_key, source_surface, is_load_test)
     VALUES ($1, $2, $3, $4, $5, false)
     ON CONFLICT DO NOTHING`,
    [input.businessId, input.eventType, rotatingFingerprint(input.userId), input.safeDemandKey ?? null, input.surface],
  );
}
```

### No-sensitive-demand rule

Before a demand key is eligible, the `classifyGrowthSensitivity`/universal-search policy must return `public`, not `sensitive` or `private`. Block medical, mental health, fertility, HIV/STI, divorce, domestic violence, immigration status, legal risk, financial hardship, exact travel, child, religion, politics, and protected-person queries. Do not create a business demand signal from any blocked class.

