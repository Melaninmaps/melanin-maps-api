## Part B — Non-inferential author/outlet validation code

**New file:** `artifacts/api-server/src/library/source-identity-validator.ts`

```ts
import { URL } from 'node:url';

export type SourceIdentity = {
  canonicalUrl: string;
  currentUrl: string;
  normalizedDomain: string;
  title: string | null;
  publisherName: string | null;
  publisherType: string;
  authorDisplay: string | null;
  authorProfileUrl: string | null;
  languageCode: string | null;
  countryCode: string | null;
  publishedAt: string | null;
  updatedAtSource: string | null;
  selfDescribedPerspective: Record<string, string>;
};

const FORBIDDEN_HOSTS = new Set(['localhost', '127.0.0.1', '::1']);

export function assertPublicHttpsUrl(value: string): URL {
  const url = new URL(value);
  if (url.protocol !== 'https:') throw new Error('SOURCE_URL_NOT_HTTPS');
  if (FORBIDDEN_HOSTS.has(url.hostname) || isPrivateNetworkHost(url.hostname)) {
    throw new Error('SOURCE_URL_NOT_PUBLIC');
  }
  if (url.username || url.password) throw new Error('SOURCE_URL_HAS_CREDENTIALS');
  return url;
}

export async function validateSourceIdentity(candidateUrl: string): Promise<SourceIdentity> {
  const requested = assertPublicHttpsUrl(candidateUrl);
  const response = await fetch(requested, {
    redirect: 'follow',
    signal: AbortSignal.timeout(10_000),
    headers: { 'user-agent': 'MappingWithMelanin-LibraryValidator/1.0 (+https://www.mappingwithmelanin.com)' },
  });
  if (!response.ok) throw new Error(`SOURCE_HTTP_${response.status}`);
  const finalUrl = assertPublicHttpsUrl(response.url);
  const html = await response.text();
  const metadata = extractPublicMetadata(html, finalUrl);

  // IMPORTANT: extractPublicMetadata may read JSON-LD, OpenGraph, citation,
  // <meta name="author"> and explicit publisher/about metadata. It MUST NOT
  // infer demographics, religion, political affiliation, nationality, or
  // credentials from names, images, domains, language, or location.
  return {
    canonicalUrl: metadata.canonicalUrl ?? finalUrl.toString(),
    currentUrl: finalUrl.toString(),
    normalizedDomain: finalUrl.hostname.toLowerCase().replace(/^www\./, ''),
    title: metadata.title ?? null,
    publisherName: metadata.publisherName ?? null,
    publisherType: classifyPublisherFromApprovedEvidence(metadata, finalUrl),
    authorDisplay: metadata.authorDisplay ?? null,
    authorProfileUrl: metadata.authorProfileUrl ?? null,
    languageCode: metadata.languageCode ?? null,
    countryCode: metadata.countryCode ?? null,
    publishedAt: metadata.publishedAt ?? null,
    updatedAtSource: metadata.updatedAtSource ?? null,
    selfDescribedPerspective: metadata.selfDescribedPerspective ?? {},
  };
}

export function allowPerspectiveTiebreaker(value: Record<string, string>): boolean {
  // Only a verified public self-description / publisher-supplied about page /
  // curator-confirmed evidence URL can populate this field.
  return Boolean(value.label && value.evidence_url);
}
```

**Explicit prohibitions:**

```ts
// NEVER write code like this:
// inferRace(authorName); inferNationality(authorName); inferGender(photo);
// inferMinorityOwnership(domain); inferIdentityFromLanguage(authorName);
```

If metadata lacks an author or self-description, store `NULL`/`{}`. The source may still be valid and rank on policy/relevance/freshness. A public bio that explicitly says an author is a Black obstetrician, or an outlet’s own About page that says it is Venezuelan, may be stored as an attributable source fact only with the bio/about-page URL in `self_described_perspective.evidence_url`.

**Source rank:**

```ts
export function sourceRank(s: {
  active: boolean; topicalRelevance: number; policyFit: number;
  freshness: number; popularity: number; perspective: number;
  highConsequence: boolean;
}): number | null {
  if (!s.active || s.topicalRelevance < 0.60 || s.policyFit < 0.70) return null;
  return 0.55 * s.topicalRelevance +
    0.25 * s.policyFit +
    0.15 * s.freshness +
    (s.highConsequence ? 0.03 : 0.10) * s.popularity +
    (s.highConsequence ? 0 : 0.05) * s.perspective;
}
```

