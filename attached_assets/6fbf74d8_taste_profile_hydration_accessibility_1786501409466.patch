+import { describe, expect, it, vi } from 'vitest';
+import { render, screen, waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import TravelPage from './travel';
+import { api } from '../lib/api';
+
+vi.mock('../lib/api', () => ({
+  api: {
+    get: vi.fn(),
+    put: vi.fn(),
+  },
+}));
+
+describe('Kinfolk Taste Profile response-style hydration', () => {
+  it('hydrates Detailed from the persisted server contract instead of legacy conversational state', async () => {
+    vi.mocked(api.get).mockResolvedValueOnce({
+      data: {
+        preferences: { communicationStyle: 'friendly' },
+        responseStyle: 'detailed',
+        deliveryProfile: { detailLevel: 'deep', tonePreference: 'default' },
+      },
+    });
+
+    render(<TravelPage />);
+
+    await waitFor(() => {
+      expect(screen.getByTestId('kinfolk-response-style-detailed')).toHaveAttribute('aria-pressed', 'true');
+    });
+    expect(screen.getByTestId('kinfolk-response-style-conversational')).toHaveAttribute('aria-pressed', 'false');
+  });
+
+  it('keeps Detailed selected after the Save Taste Profile response is normalized by the server', async () => {
+    const user = userEvent.setup();
+    vi.mocked(api.get).mockResolvedValueOnce({
+      data: { preferences: { communicationStyle: 'friendly' }, responseStyle: 'conversational' },
+    });
+    vi.mocked(api.put)
+      .mockResolvedValueOnce({ data: {} })
+      .mockResolvedValueOnce({
+        data: {
+          responseStyle: 'detailed',
+          deliveryProfile: { detailLevel: 'deep', tonePreference: 'default' },
+        },
+      });
+
+    render(<TravelPage />);
+    await user.click(await screen.findByTestId('kinfolk-response-style-detailed'));
+    await user.click(screen.getByTestId('kinfolk-save-taste-profile'));
+
+    await waitFor(() => {
+      expect(screen.getByTestId('kinfolk-response-style-detailed')).toHaveAttribute('aria-pressed', 'true');
+    });
+  });
