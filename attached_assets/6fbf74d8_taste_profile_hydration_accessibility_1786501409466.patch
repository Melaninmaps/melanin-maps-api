# Mapping With Melanin — Taste Profile Hydration + Accessibility Patch
#
# TARGET: the ACTIVE web Taste Profile component that renders:
#   Conversational | Concise | Detailed | Professional
#
# OBSERVED BUG
# The server returns responseStyle: "detailed" and deliveryProfile.detailLevel:
# "deep" after save, but the web page restores Conversational after hard refresh.
# This means a legacy default/communicationStyle assignment is overwriting the
# new persisted response-style contract during client hydration.
#
# NO-TOUCH BOUNDARY
# Do not modify authentication, Maps, Safety, Library, business pages, Circles,
# backend routes, or the mobile app in this patch.
#
# PRE-FLIGHT
#   git grep -n "Save Taste Profile\|selectedResponseStyle\|communicationStyle" client/src
# Apply this to the component returned by the active /travel route. In the
# current project this is expected to be client/src/pages/travel.tsx.

--- a/client/src/pages/travel.tsx
+++ b/client/src/pages/travel.tsx
@@
-import { useEffect, useState } from 'react';
+import { useEffect, useState } from 'react';
@@
-type ResponseStyle = 'conversational' | 'concise' | 'detailed' | 'professional';
+type ResponseStyle = 'conversational' | 'concise' | 'detailed' | 'professional';
+
+type KinfolkPreferencesResponse = {
+  preferences: {
+    // Keep the existing legacy preference fields here.
+    communicationStyle?: string | null;
+    [key: string]: unknown;
+  };
+  // New server contract. This is the first-priority display value.
+  responseStyle?: ResponseStyle | null;
+  deliveryProfile?: {
+    detailLevel?: 'quick' | 'standard' | 'deep' | null;
+    detail_level?: 'quick' | 'standard' | 'deep' | null;
+    tonePreference?: 'default' | 'warm' | 'professional' | null;
+    tone_preference?: 'default' | 'warm' | 'professional' | null;
+  } | null;
+};
+
+const RESPONSE_STYLE_OPTIONS: ReadonlyArray<{
+  id: ResponseStyle;
+  label: string;
+}> = [
+  { id: 'conversational', label: 'Conversational' },
+  { id: 'concise', label: 'Concise' },
+  { id: 'detailed', label: 'Detailed' },
+  { id: 'professional', label: 'Professional' },
+];
+
+function isResponseStyle(value: unknown): value is ResponseStyle {
+  return value === 'conversational' || value === 'concise' || value === 'detailed' || value === 'professional';
+}
+
+/**
+ * IMPORTANT PRECEDENCE ORDER
+ * 1. responseStyle is the canonical persisted user choice.
+ * 2. deliveryProfile is the compatibility fallback.
+ * 3. legacy communicationStyle is read only if neither new field exists.
+ *
+ * Never apply legacy communicationStyle after this function. That is what
+ * previously reset Detailed to Conversational after a reload.
+ */
+function resolveResponseStyle(payload: KinfolkPreferencesResponse): ResponseStyle {
+  if (isResponseStyle(payload.responseStyle)) return payload.responseStyle;
+
+  const profile = payload.deliveryProfile;
+  const tone = profile?.tonePreference ?? profile?.tone_preference;
+  const detail = profile?.detailLevel ?? profile?.detail_level;
+
+  if (tone === 'professional') return 'professional';
+  if (detail === 'deep') return 'detailed';
+  if (detail === 'quick') return 'concise';
+
+  // Compatibility only. Map existing backend vocabulary once, before default.
+  if (payload.preferences.communicationStyle === 'professional') return 'professional';
+  if (payload.preferences.communicationStyle === 'concise') return 'concise';
+  if (payload.preferences.communicationStyle === 'detailed') return 'detailed';
+  return 'conversational';
+}
