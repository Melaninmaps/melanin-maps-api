+const saveTasteProfile = async () => {
+  await api.put('/api/kinfolk/preferences', tasteProfile);
+  const { data } = await api.put<{
+    responseStyle: ResponseStyle;
+    deliveryProfile: KinfolkPreferencesResponse['deliveryProfile'];
+  }>('/api/kinfolk/preferences/response-style', {
+    responseStyle: selectedResponseStyle,
+  });
+
+  // Preserve the server-normalized result. Do not reset to a legacy default.
+  setSelectedResponseStyle(resolveResponseStyle({
+    preferences: tasteProfile,
+    responseStyle: data.responseStyle,
+    deliveryProfile: data.deliveryProfile,
+  }));
+};
