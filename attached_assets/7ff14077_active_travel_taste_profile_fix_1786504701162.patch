 type CommunicationStyle = 'friendly' | 'concise' | 'detailed' | 'professional';
 type ResponseStyle = 'conversational' | 'concise' | 'detailed' | 'professional';
 
+const RESPONSE_STYLE_TO_ACTIVE_ID: Record<ResponseStyle, CommunicationStyle> = {
+  conversational: 'friendly',
+  concise: 'concise',
+  detailed: 'detailed',
+  professional: 'professional',
+};
+
+const ACTIVE_ID_TO_RESPONSE_STYLE: Record<CommunicationStyle, ResponseStyle> = {
+  friendly: 'conversational',
+  concise: 'concise',
+  detailed: 'detailed',
+  professional: 'professional',
+};
+
+type KinfolkPreferenceEnvelope = {
+  preferences?: Partial<KinfolkPreferences>;
+  responseStyle?: ResponseStyle | null;
+  deliveryProfile?: {
+    detailLevel?: 'quick' | 'standard' | 'deep' | null;
+    detail_level?: 'quick' | 'standard' | 'deep' | null;
+    tonePreference?: 'default' | 'warm' | 'professional' | null;
+    tone_preference?: 'default' | 'warm' | 'professional' | null;
+  } | null;
+};
+
+function isResponseStyle(value: unknown): value is ResponseStyle {
+  return value === 'conversational' || value === 'concise' || value === 'detailed' || value === 'professional';
+}
+
+/**
+ * Converts the API envelope to the exact legacy field used by the ACTIVE
+ * Taste Profile component. Explicit API responseStyle wins; deliveryProfile
+ * is its compatibility fallback; legacy communicationStyle is last.
+ */
+function resolveActiveCommunicationStyle(
+  envelope: KinfolkPreferenceEnvelope,
+  legacyStyle: unknown,
+): CommunicationStyle {
+  if (isResponseStyle(envelope.responseStyle)) {
+    return RESPONSE_STYLE_TO_ACTIVE_ID[envelope.responseStyle];
+  }
+
+  const profile = envelope.deliveryProfile;
+  const detailLevel = profile?.detailLevel ?? profile?.detail_level;
+  const tonePreference = profile?.tonePreference ?? profile?.tone_preference;
+  if (tonePreference === 'professional') return 'professional';
+  if (detailLevel === 'deep') return 'detailed';
+  if (detailLevel === 'quick') return 'concise';
+
+  if (legacyStyle === 'friendly' || legacyStyle === 'concise' || legacyStyle === 'detailed' || legacyStyle === 'professional') {
+    return legacyStyle;
+  }
+  return 'friendly';
+}
