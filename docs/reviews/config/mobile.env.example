# Mobile App Environment Variables (Expo)
# Mapping With Melanin™ — Build 97 Review Package
# Template only — no values included.
# EAS env vars are set in eas.json env blocks and the EAS Dashboard.
# EXPO_PUBLIC_* vars are embedded in the app bundle (public, visible to clients).

# ─── API URL ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=              # Full API base URL. e.g., https://www.mappingwithmelanin.com
                                  # Platform: Mobile app (Expo)
                                  # Use: All API calls from mobile
                                  # Dev: Replit preview URL
                                  # Prod: https://www.mappingwithmelanin.com
                                  # Currently configured: Yes (EAS Dashboard)

# ─── RevenueCat ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=      # iOS RevenueCat public API key
                                          # Platform: Mobile (iOS)
                                          # Use: IAP subscription management
                                          # Currently configured: Yes (eas.json)
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=  # Android RevenueCat public API key
                                          # Platform: Mobile (Android)
                                          # Currently configured: Yes (eas.json)
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=     # Test/sandbox key (currently same as iOS)

# ─── Google Maps (Mobile) ────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=              # Google Maps API key for mobile builds.
                                  # Platform: Mobile (EAS build-time env)
                                  # Use: react-native-maps initialization (Android)
                                  # Note: NOT set in iOS native config (avoids pod conflict)
                                  # Currently configured: Yes (eas.json preview/production)

# ─── Expo / EAS ──────────────────────────────────────────────────────────────
EXPO_TOKEN=                       # Expo authentication token for EAS CLI.
                                  # Platform: Build environment only (Replit)
                                  # Use: eas build, eas submit, eas update
                                  # Currently configured: Yes (Replit secret)
EXPO_PUBLIC_DOMAIN=               # Production domain. www.mappingwithmelanin.com
                                  # Platform: Mobile app
                                  # Use: API URL construction, deep links

# ─── Build Configuration ─────────────────────────────────────────────────────
EXPO_PUBLIC_REPL_ID=              # Replit Repl ID. Used for dev server URL construction.
                                  # Platform: Mobile (dev/preview builds only)
PNPM_VERSION=                     # pnpm version for EAS build environment.
                                  # Platform: EAS build environment
                                  # Currently configured: 10.26.1 (eas.json)
