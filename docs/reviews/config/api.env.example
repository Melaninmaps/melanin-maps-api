# API Server Environment Variables
# Mapping With Melanin™ — Build 97 Review Package
# Template only — no values included. All secrets managed via Replit Secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                     # Required. PostgreSQL connection string (Railway).
                                  # Local/internal: no SSL. Production: SSL required.
                                  # Platform: API server
                                  # Use: All database operations
                                  # Currently configured: Yes (Railway Postgres)

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=                   # Required. Secret for session signing.
                                  # Platform: API server
                                  # Use: Session cookie signing
                                  # Currently configured: Yes

# ─── Authentication (OIDC / Replit) ─────────────────────────────────────────
REPL_ID=                          # Replit Repl ID. Auto-set by Replit environment.
ISSUER_URL=                       # OIDC issuer URL. Auto-configured.
REPLIT_DOMAINS=                   # Comma-separated preview domains. Auto-set.

# ─── Apple Sign-In ──────────────────────────────────────────────────────────
APPLE_KEY_ID=                     # Required for Apple Sign-In. Apple key identifier.
                                  # Platform: API server
                                  # Use: Apple JWT signing for token exchange
                                  # Currently configured: Yes
APPLE_TEAM_ID=                    # Required. Apple Developer Team ID.
APPLE_PRIVATE_KEY=                # Required. Apple .p8 private key content.
APPLE_TOKEN_ENCRYPTION_KEY=       # Required. Key for AES-256-GCM encrypting Apple refresh tokens.
                                  # Must be 256 bits (32 bytes), hex-encoded.

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=              # Required for map JS API on web.
                                  # Platform: API server (served via GET /api/maps/js-key)
                                  # Use: Google Maps JS API key delivery
                                  # Currently configured: Yes

# ─── AI / KinfolkAI ─────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=   # Required. OpenAI API key via Replit AI Integrations proxy.
                                  # Platform: API server
                                  # Use: KinfolkAI chat completions + TTS
                                  # Currently configured: Yes
AI_INTEGRATIONS_OPENAI_BASE_URL=  # Required. Replit AI Integrations proxy base URL.

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=                   # Required for transactional email.
                                  # Platform: API server
                                  # Use: Welcome emails, trial reminders, password reset
                                  # Currently configured: Unknown — check Railway

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                # Required. Stripe secret key (sk_live_* or sk_test_*)
                                  # Platform: API server
                                  # Use: Stripe billing, customer creation, subscription management
                                  # Currently configured: Yes (Replit integration)
STRIPE_WEBHOOK_SECRET=            # Required. Stripe webhook signing secret (whsec_*)
                                  # Platform: API server
                                  # Use: Webhook signature verification
                                  # Currently configured: Yes

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAILS=                     # Comma-separated admin emails.
                                  # Platform: API server
                                  # Use: Admin route access on startup
                                  # Currently configured: Unknown

# ─── Storage ─────────────────────────────────────────────────────────────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID= # Replit Object Storage bucket ID.
                                  # Platform: API server
                                  # Use: Profile photos, verification images, business photos
                                  # Currently configured: Yes
PRIVATE_OBJECT_DIR=               # Private object storage directory prefix.
PUBLIC_OBJECT_SEARCH_PATHS=       # Public object storage search paths.

# ─── Push Notifications ──────────────────────────────────────────────────────
# No server-side push token key required — Expo Push Service handles delivery.
# Push tokens stored in push_tokens table.

# ─── DocuSign ────────────────────────────────────────────────────────────────
DOCUSIGN_USER_ID=                 # DocuSign user ID for JWT auth.
                                  # Platform: API server
                                  # Currently configured: Yes
DOCUSIGN_RSA_PRIVATE_KEY=         # DocuSign RSA private key.

# ─── Other Services ──────────────────────────────────────────────────────────
WMATA_API_KEY=                    # WMATA (DC Metro) API key.
                                  # Platform: API server
                                  # Use: DC transit data in travel context
                                  # Currently configured: Yes
TWILIO_ACCOUNT_SID=               # Twilio account SID.
                                  # Platform: API server
                                  # Use: Phone authentication (partial implementation)
TWILIO_AUTH_TOKEN=                # Twilio auth token.
CRON_SECRET=                      # Secret for cron job endpoints.
COMPANY_MAILING_ADDRESS=          # Legal mailing address for emails.

# ─── Runtime / Platform ──────────────────────────────────────────────────────
PORT=                             # Server port. Auto-set by Replit/Railway (8080).
NODE_ENV=                         # "development" or "production"
RAILWAY_ACCOUNT_TOKEN=            # Railway API token (for deployment automation).
